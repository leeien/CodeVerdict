# Keep the image lean, but note the build needs pyproject.toml, README.md and
# LICENSE (the package metadata references the README), so those are NOT ignored.
**/__pycache__/
**/*.py[cod]
**/.venv/
.venv/
**/.workspace/
.qdrant/
.knowledge/
*.db
*.db-journal
*.db-wal
*.log
logs/
.env
.secret.key
.git/
.github/
.claude/
docs/
tests/
benchmarks/

index 98e2577..4c07160 100644
--- a/tests/test_termui.py
+++ b/tests/test_termui.py
@@ -350,6 +350,51 @@ def test_progress_bar_update_min_steps(runner):
     assert bar.pos == 5
 
 
+def test_progressbar_format_speed_no_data(runner):
+    with _create_progress(10) as progress:
+        # avg is empty before any steps — should return "?"
+        assert progress.format_speed() == "?"
+
+
+@pytest.mark.parametrize(
+    "avg, expected",
+    [
+        ([1.0], "1.00/s"),
+        ([0.5], "2.00/s"),
+        ([0.25, 0.75], "2.00/s"),  # avg time_per_iteration = 0.5 => 2.00/s
+    ],
+)
+def test_progressbar_format_speed(runner, avg, expected):
+    with _create_progress(10, avg=avg) as progress:
+        assert progress.format_speed() == expected
+
+
+def test_progressbar_show_speed_off_by_default(runner):
+    with _create_progress(10, avg=[0.5]) as progress:
+        line = progress.format_progress_line()
+        assert "/s" not in line
+
+
+def test_progressbar_show_speed_in_progress_line(runner):
+    with _create_progress(10, avg=[0.5], show_speed=True) as progress:
+        line = progress.format_progress_line()
+        assert "2.00/s" in line
+
+
+def test_progressbar_show_speed_hidden_when_finished(runner):
+    with _create_progress(10, avg=[0.5], show_speed=True, finished=True) as progress:
+        line = progress.format_progress_line()
+        assert "/s" not in line
+
+
+def test_progressbar_show_speed_via_progressbar_function(runner):
+    bar = click.progressbar(range(10), show_speed=True)
+    assert bar.show_speed is True
+
+    bar_default = click.progressbar(range(10))
+    assert bar_default.show_speed is False
+
+
 @pytest.mark.parametrize("key_char", ("h", "H", "é", "À", " ", "字", "àH", "àR"))
 @pytest.mark.parametrize("echo", [True, False])
 @pytest.mark.skipif(not WIN, reason="Tests user-input using the msvcrt module.")

+def test_apply_link_style_gives_unique_link_ids() -> None:
+    """Regression: two @click segments with the same action must get different _link_ids.
+
+    Rich's Style.__add__ is lru_cached, so two segments built from the same
+    Style objects share the same combined object and thus the same _link_id.
+    _apply_link_style must assign a fresh _link_id to each segment so that
+    hovering one never highlights the other.
+    """
+    click_style = Style.on(click="app.foo")
+    base_style = Style(underline=True)
+    # Both segments share the same cached combined style → same _link_id before fix.
+    shared = click_style + base_style
+    strip = Strip([Segment("foo", shared), Segment("bar", shared)])
+
+    link_style = Style(italic=True)
+    result = strip._apply_link_style(link_style)
+    segs = list(result)
+
+    foo_id = segs[0].style._link_id
+    bar_id = segs[1].style._link_id
+    assert foo_id != bar_id, (
+        "_apply_link_style must assign unique _link_ids to each @click segment"
+    )
+
+
+def test_apply_link_style_hover_independence() -> None:
+    """Regression: style_links after _apply_link_style must only highlight the hovered segment.
+
+    When two @click segments have the same underlying action, hovering one
+    must not highlight the other.
+    """
+    click_style = Style.on(click="app.foo")
+    shared = click_style + Style(underline=True)
+    strip = Strip([Segment("foo", shared), Segment("bar", shared)])
+
+    link_style = Style(italic=True)
+    result = strip._apply_link_style(link_style)
+    segs = list(result)
+
+    foo_id = segs[0].style._link_id
+    bar_id = segs[1].style._link_id
+
+    hover_style = Style(bold=True)
+
+    # Hover over "foo" — only foo should become bold
+    foo_hover = result.style_links(foo_id, hover_style)
+    foo_segs = list(foo_hover)
+    assert foo_segs[0].style.bold, "hovered segment should be highlighted"
+    assert not foo_segs[1].style.bold, "non-hovered same-action segment must not be highlighted"
+
+    # Hover over "bar" — only bar should become bold
+    bar_hover = result.style_links(bar_id, hover_style)
+    bar_segs = list(bar_hover)
+    assert not bar_segs[0].style.bold, "non-hovered same-action segment must not be highlighted"
+    assert bar_segs[1].style.bold, "hovered segment should be highlighted"
+
+
+def test_apply_link_style_different_actions_stay_independent() -> None:
+    """Segments with different @click actions must remain independently identifiable."""
+    style_foo = Style.on(click="app.foo")
+    style_bar = Style.on(click="app.bar")
+    strip = Strip([Segment("foo", style_foo), Segment("bar", style_bar)])
+
+    link_style = Style(italic=True)
+    result = strip._apply_link_style(link_style)
+    segs = list(result)
+
+    foo_id = segs[0].style._link_id
+    bar_id = segs[1].style._link_id
+    assert foo_id != bar_id
+
+    hover_style = Style(bold=True)
+    foo_hover = result.style_links(foo_id, hover_style)
+    foo_segs = list(foo_hover)
+    assert foo_segs[0].style.bold
+    assert not foo_segs[1].style.bold

+def _fresh_link_id(style: Style) -> Style:
+    """Return a copy of a Rich Style with a new unique _link_id.
+
+    Rich's Style.__add__ is lru_cached, so two segments built from the same
+    input styles share the same combined Style object and therefore the same
+    _link_id.  This causes style_links() to highlight *all* such segments
+    whenever any one of them is hovered.  Cloning with a fresh counter value
+    ensures every @click segment is independently identifiable.
+    """
+    fresh = style.__class__.__new__(style.__class__)
+    fresh._color = style._color
+    fresh._bgcolor = style._bgcolor
+    fresh._attributes = style._attributes
+    fresh._set_attributes = style._set_attributes
+    fresh._link = style._link
+    fresh._meta = style._meta
+    fresh._link_id = f"{next(_rich_id_generator)}{hash(style._meta)}"
+    fresh._ansi = None
+    fresh._style_definition = None
+    fresh._hash = None
+    fresh._null = style._null
+    return fresh
+

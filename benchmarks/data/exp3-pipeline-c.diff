diff --git a/tests/test_console.py b/tests/test_console.py
index e52c1b36..f0b1874f 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -1133,3 +1133,40 @@ def test_tty_compatible() -> None:
     assert not console.is_terminal
     # Should not have auto-detected
     assert not console.file.called_isatty
+
+
+def test_hyperlink_not_fragmented_by_emphasis() -> None:
+    """A URL with partial emphasis must render as a single OSC 8 hyperlink pair."""
+    console = Console(
+        force_terminal=True, legacy_windows=False, color_system="truecolor"
+    )
+    text = Text("click here")
+    text.stylize(Style(link="https://example.com"))
+    text.stylize(Style(bold=True), 6, 10)
+
+    with console.capture() as capture:
+        console.print(text, end="")
+
+    output = capture.get()
+    # The URL should appear exactly once (one OSC 8 open sequence)
+    assert output.count("https://example.com") == 1
+    # Exactly one OSC 8 close sequence for the link
+    assert output.count("\x1b]8;;\x1b\\") == 1
+
+
+def test_adjacent_different_urls_stay_separate() -> None:
+    """Two adjacent URLs with different hrefs must not be merged."""
+    console = Console(
+        force_terminal=True, legacy_windows=False, color_system="truecolor"
+    )
+    text = Text()
+    text.append("first", style=Style(link="https://first.com"))
+    text.append("second", style=Style(link="https://second.com"))
+
+    with console.capture() as capture:
+        console.print(text, end="")
+
+    output = capture.get()
+    assert output.count("https://first.com") == 1
+    assert output.count("https://second.com") == 1
+    assert output.count("\x1b]8;;\x1b\\") == 2
diff --git a/tests/test_style.py b/tests/test_style.py
index 84a65a67..f8295756 100644
--- a/tests/test_style.py
+++ b/tests/test_style.py
@@ -265,3 +265,20 @@ def test_clear_meta_and_links_clears_hash():
 
     clear_style = style.clear_meta_and_links()
     assert clear_style._hash is None
+
+
+def test_combine_preserves_link_when_override_has_none():
+    """Style composition preserves the base link when the override carries no link."""
+    link_style = Style(link="https://example.com", color="red")
+    no_link_style = Style(bold=True)
+    combined = link_style + no_link_style
+    assert combined.link == "https://example.com"
+
+    # Override wins when both styles carry a link
+    other_link_style = Style(link="https://other.com")
+    combined2 = link_style + other_link_style
+    assert combined2.link == "https://other.com"
+
+    # Neither style has a link — composed result has no link
+    combined3 = Style(bold=True) + Style(italic=True)
+    assert combined3.link is None
diff --git a/tests/test_text.py b/tests/test_text.py
index b6d39f59..46afd4f2 100644
--- a/tests/test_text.py
+++ b/tests/test_text.py
@@ -1127,3 +1127,25 @@ def test_soft_wrap_styled() -> None:
     # Background is reset before \n
     expected = "\x1b[34;47msoft wrap is on\x1b[0m\nNext line\n"
     assert output == expected
+
+
+def test_stylize_preserves_link_on_highlighted_range() -> None:
+    """Applying emphasis to a substring preserves the link on all characters."""
+    console = Console(force_terminal=True, legacy_windows=False)
+    text = Text("click here")
+    text.stylize(Style(link="https://example.com"))
+    text.stylize(Style(bold=True), 6, 10)
+
+    segments = [seg for seg in text.render(console) if seg.style]
+    assert all(seg.style.link == "https://example.com" for seg in segments)
+
+
+def test_non_overlapping_highlight_does_not_affect_link() -> None:
+    """A highlight on non-overlapping text does not discard the link on any segment."""
+    console = Console(force_terminal=True, legacy_windows=False)
+    text = Text("prefix suffix")
+    text.stylize(Style(link="https://example.com"))
+    text.stylize(Style(bold=True), 0, 6)
+
+    segments = [seg for seg in text.render(console) if seg.style]
+    assert all(seg.style.link == "https://example.com" for seg in segments)

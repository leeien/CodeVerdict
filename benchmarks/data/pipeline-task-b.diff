@@ -1,5 +1,6 @@
-from tinydb import where
+from tinydb import TinyDB, where
 from tinydb.operations import delete, increment, decrement, add, subtract, set
+from tinydb.storages import MemoryStorage
 
 
 def test_delete(db):
@@ -35,3 +36,51 @@ def test_increment(db):
 def test_decrement(db):
     db.update(decrement('int'), where('char') == 'a')
     assert db.get(where('char') == 'a')['int'] == 0
+
+
+def test_add_missing_field():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'val': 10})
+    db.insert({'other': 'no_val'})
+    db.update(add('val', 5))
+    docs = db.all()
+    with_field = [d for d in docs if 'val' in d]
+    without_field = [d for d in docs if 'val' not in d]
+    assert len(with_field) == 1 and with_field[0]['val'] == 15
+    assert len(without_field) == 1 and without_field[0]['other'] == 'no_val'
+
+
+def test_subtract_missing_field():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'val': 10})
+    db.insert({'other': 'no_val'})
+    db.update(subtract('val', 3))
+    docs = db.all()
+    with_field = [d for d in docs if 'val' in d]
+    without_field = [d for d in docs if 'val' not in d]
+    assert len(with_field) == 1 and with_field[0]['val'] == 7
+    assert len(without_field) == 1 and without_field[0]['other'] == 'no_val'
+
+
+def test_increment_missing_field():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'val': 10})
+    db.insert({'other': 'no_val'})
+    db.update(increment('val'))
+    docs = db.all()
+    with_field = [d for d in docs if 'val' in d]
+    without_field = [d for d in docs if 'val' not in d]
+    assert len(with_field) == 1 and with_field[0]['val'] == 11
+    assert len(without_field) == 1 and without_field[0]['other'] == 'no_val'
+
+
+def test_decrement_missing_field():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'val': 10})
+    db.insert({'other': 'no_val'})
+    db.update(decrement('val'))
+    docs = db.all()
+    with_field = [d for d in docs if 'val' in d]
+    without_field = [d for d in docs if 'val' not in d]
+    assert len(with_field) == 1 and with_field[0]['val'] == 9
+    assert len(without_field) == 1 and without_field[0]['other'] == 'no_val'

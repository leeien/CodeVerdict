diff --git a/tests/test_console.py b/tests/test_console.py
index e52c1b36..e6aa7910 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -1133,3 +1133,59 @@ def test_tty_compatible() -> None:
     assert not console.is_terminal
     # Should not have auto-detected
     assert not console.file.called_isatty
+
+
+def test_link_coalescing_in_render_buffer() -> None:
+    """Emphasized text spanning a single hyperlink should produce one OSC 8 pair."""
+    from rich.segment import Segment
+    from rich.style import Style
+
+    console = Console(force_terminal=True, color_system="truecolor")
+    url = "https://example.com"
+    bold_link = Style(bold=True, link=url)
+    italic_link = Style(italic=True, link=url)
+    buffer = [
+        Segment("Hello", bold_link),
+        Segment(" World", italic_link),
+    ]
+    rendered = console._render_buffer(buffer)
+    # Only one opening OSC 8 sequence for the URL
+    assert rendered.count(f"\x1b]8;") == 2  # one open + one close pair
+    assert url in rendered
+    # Bold ANSI code present
+    assert "\x1b[1m" in rendered
+    # Italic ANSI code present
+    assert "\x1b[3m" in rendered
+
+
+def test_multiple_links_not_coalesced() -> None:
+    """Different hyperlinks must remain separate OSC 8 pairs."""
+    from rich.segment import Segment
+    from rich.style import Style
+
+    console = Console(force_terminal=True, color_system="truecolor")
+    url1 = "https://example.com"
+    url2 = "https://other.com"
+    buffer = [
+        Segment("First", Style(bold=True, link=url1)),
+        Segment("Second", Style(italic=True, link=url2)),
+    ]
+    rendered = console._render_buffer(buffer)
+    # Two opening sequences — one per URL
+    assert rendered.count(f"\x1b]8;id=") == 2
+    assert url1 in rendered
+    assert url2 in rendered
+
+
+def test_plain_link_unchanged() -> None:
+    """Plain (non-emphasized) links should still render correctly."""
+    from rich.segment import Segment
+    from rich.style import Style
+
+    console = Console(force_terminal=True, color_system="truecolor")
+    url = "https://example.com"
+    buffer = [Segment("click me", Style(link=url))]
+    rendered = console._render_buffer(buffer)
+    assert url in rendered
+    assert "click me" in rendered
+    assert "\x1b]8;" in rendered

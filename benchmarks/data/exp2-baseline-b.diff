                 value = self.process_value(ctx, value)
+            except BadParameter as e:
+                if source is ParameterSource.ENVIRONMENT and e.env_var is None:
+                    e.env_var = self.get_active_envvar(ctx)
+                if not ctx.resilient_parsing:
+                    raise
+                value = UNSET
             except Exception:
                 if not ctx.resilient_parsing:
                     raise
@@ -3579,6 +3602,26 @@ class Option(Parameter):
 
         return rv
 
+    def get_active_envvar(self, ctx: Context) -> str | None:
+        """:class:`Option` resolves the active environment variable the same way as
+        :meth:`Parameter.get_active_envvar`, but also checks
+        :attr:`Context.auto_envvar_prefix` as a fallback.
+
+        :meta private:
+        """
+        rv = super().get_active_envvar(ctx)
+
+        if rv is not None:
+            return rv
+
+        if self.allow_from_autoenv and ctx.auto_envvar_prefix is not None and self.name:
+            envvar = f"{ctx.auto_envvar_prefix}_{self.name.upper()}"
+
+            if os.environ.get(envvar):
+                return envvar
+
+        return None
+
     def consume_value(
         self, ctx: Context, opts: cabc.Mapping[str, Parameter]
     ) -> tuple[t.Any, ParameterSource]:

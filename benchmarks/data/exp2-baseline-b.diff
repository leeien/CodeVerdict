--- a/tests/test_options.py
+++ b/tests/test_options.py
@@ -564,11 +564,67 @@ def test_boolean_envvar_bad_values(runner, value):
     result = runner.invoke(cli, [], env={"SHOUT": value})
     assert result.exit_code == 2
     assert (
-        f"Invalid value for '--shout': {value!r} is not a valid boolean."
-        in result.output
+        f"Invalid value for '--shout' (set by environment variable 'SHOUT'): "
+        f"{value!r} is not a valid boolean." in result.output
+    )
+
+
+def test_envvar_bad_value_names_variable(runner):
+    """A type error from an env var should name the variable in the message."""
+
+    @click.command()
+    @click.option("--count", type=int, envvar="MY_COUNT")
+    def cli(count):
+        click.echo(count)
+
+    result = runner.invoke(cli, [], env={"MY_COUNT": "abc"})
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--count' (set by environment variable 'MY_COUNT'): "
+        "'abc' is not a valid integer." in result.output
     )
 
 
+def test_envvar_bad_value_multiple_envvars(runner):
+    """When multiple env vars are configured, the message names the one that is set."""
+
+    @click.command()
+    @click.option("--count", type=int, envvar=["FIRST_COUNT", "ALT_COUNT"])
+    def cli(count):
+        click.echo(count)
+
+    result = runner.invoke(cli, [], env={"ALT_COUNT": "xyz"})
+    assert result.exit_code == 2
+    assert "set by environment variable 'ALT_COUNT'" in result.output
+
+
+def test_envvar_bad_value_auto_prefix(runner):
+    """A type error from an auto-prefixed env var should name the variable."""
+
+    @click.command()
+    @click.option("--count", type=int)
+    def cli(count):
+        click.echo(count)
+
+    result = runner.invoke(cli, [], env={"CLI_COUNT": "abc"}, auto_envvar_prefix="CLI")
+    assert result.exit_code == 2
+    assert "set by environment variable 'CLI_COUNT'" in result.output
+
+
+def test_cmdline_bad_value_no_envvar_hint(runner):
+    """A type error from the command line should NOT mention any env var."""
+
+    @click.command()
+    @click.option("--count", type=int, envvar="MY_COUNT")
+    def cli(count):
+        click.echo(count)
+
+    result = runner.invoke(cli, ["--count", "abc"])
+    assert result.exit_code == 2
+    assert "environment variable" not in result.output
+    assert "Invalid value for '--count': 'abc' is not a valid integer." in result.output
+
+

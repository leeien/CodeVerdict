         return rv
 
+    def get_active_envvar(self, ctx: Context) -> str | None:
+        """Return the name of the environment variable whose value is currently
+        set and will be used for this parameter, or ``None`` if no environment
+        variable is set.
+
+        :meta private:
+        """
+        if isinstance(self.envvar, str):
+            if os.environ.get(self.envvar):
+                return self.envvar
+        elif self.envvar:
+            for envvar in self.envvar:
+                if os.environ.get(envvar):
+                    return envvar
+
+        return None
+
     def handle_parse_result(
         self, ctx: Context, opts: cabc.Mapping[str, t.Any], args: list[str]

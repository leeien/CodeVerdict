+def test_checkbox_unchecked() -> None:
+    markdown = Markdown("- [ ] unchecked item")
+    result = render(markdown)
+    assert "☐" in result
+    assert "unchecked item" in result
+    assert "[ ]" not in result
+
+
+def test_checkbox_checked_lowercase() -> None:
+    markdown = Markdown("- [x] checked item")
+    result = render(markdown)
+    assert "☑" in result
+    assert "checked item" in result
+    assert "[x]" not in result
+
+
+def test_checkbox_checked_uppercase() -> None:
+    markdown = Markdown("- [X] checked item")
+    result = render(markdown)
+    assert "☑" in result
+    assert "checked item" in result
+    assert "[X]" not in result
+
+
+def test_checkbox_plain_bullet_unchanged() -> None:
+    markdown = Markdown("- plain bullet")
+    result = render(markdown)
+    assert "•" in result
+    assert "plain bullet" in result
+    assert "☐" not in result
+    assert "☑" not in result
+
+
+def test_checkbox_non_checkbox_bracket_unchanged() -> None:
+    markdown = Markdown("- [not a checkbox] item")
+    result = render(markdown)
+    assert "•" in result
+    assert "[not a checkbox]" in result
+    assert "☐" not in result
+    assert "☑" not in result
+
+
+def test_checkbox_idempotent() -> None:
+    md_text = "- [ ] task\n- [x] done\n"
+    result1 = render(Markdown(md_text))
+    result2 = render(Markdown(md_text))
+    assert result1 == result2
+
+

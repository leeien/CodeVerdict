+    def _get_checkbox(self) -> str | None:
+        """Detect GFM checkbox syntax in the first paragraph and return a Unicode symbol."""
+        elements = list(self.elements)
+        if not elements or not isinstance(elements[0], Paragraph):
+            return None
+        plain = elements[0].text.plain
+        if len(plain) >= 4 and plain[0] == "[" and plain[2] == "]" and plain[3] == " ":
+            if plain[1] == " ":
+                return "☐"
+            if plain[1] in "xX":
+                return "☑"
+        return None

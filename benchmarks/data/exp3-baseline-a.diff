+def test_task_list_checkboxes() -> None:
+    """Task list items render ☐/☑ instead of bullet points."""
+    markdown = Markdown(
+        "- [ ] unchecked item\n- [x] checked item\n- [X] also checked\n"
+    )
+    result = render(markdown)
+    assert " ☐ " in result
+    assert " ☑ " in result
+    assert " • " not in result
+    assert "[ ]" not in result
+    assert "[x]" not in result
+    assert "[X]" not in result
+    assert "unchecked item" in result
+    assert "checked item" in result
+    assert "also checked" in result
+
+
+def test_task_list_plain_bullets_unchanged() -> None:
+    """Ordinary bullet lists continue to render with • bullets."""
+    markdown = Markdown("- apples\n- oranges\n- pears\n")
+    result = render(markdown)
+    assert " • " in result
+    assert "☐" not in result
+    assert "☑" not in result
+
+
+def test_task_list_mixed_with_plain() -> None:
+    """A list that mixes task items and plain bullets renders each correctly."""
+    markdown = Markdown(
+        "- [ ] task one\n- [x] task two\n- plain item\n"
+    )
+    result = render(markdown)
+    assert " ☐ " in result
+    assert " ☑ " in result
+    assert " • " in result
+    assert "task one" in result
+    assert "task two" in result
+    assert "plain item" in result
+
+
+def test_task_list_text_stripped() -> None:
+    """The checkbox prefix is stripped from the rendered text."""
+    markdown = Markdown("- [ ] do the thing\n")
+    result = render(markdown)
+    assert "[ ]" not in result
+    assert "do the thing" in result
+
+
 if __name__ == "__main__":
     markdown = Markdown(MARKDOWN)
     rendered = render(markdown)

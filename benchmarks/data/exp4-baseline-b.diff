+async def test_remove_row_shrinks_auto_column_width():
+    """Removing a row that held the widest value in an auto-width column
+    should cause the column to shrink back to fit the remaining content."""
+    app = DataTableApp()
+    async with app.run_test() as pilot:
+        table: DataTable = app.query_one(DataTable)
+        (col,) = table.add_columns("col")
+        table.add_row("short", key="r1")
+        table.add_row("a much longer value", key="r2")
+        await pilot.pause()
+
+        assert table.columns[col].content_width == len("a much longer value")
+
+        table.remove_row("r2")
+        await pilot.pause()
+
+        assert table.columns[col].content_width == len("short")
+
+
+async def test_remove_row_shrinks_column_to_label_width_when_no_rows_remain():
+    """When all data rows are removed the auto-width column should fall back
+    to the label width, not stay at the previous maximum content width."""
+    app = DataTableApp()
+    async with app.run_test() as pilot:
+        table: DataTable = app.query_one(DataTable)
+        (col,) = table.add_columns("lbl")
+        table.add_row("very wide content here", key="r1")
+        await pilot.pause()
+
+        assert table.columns[col].content_width == len("very wide content here")
+
+        table.remove_row("r1")
+        await pilot.pause()
+
+        assert table.columns[col].content_width == len("lbl")
+
+
+async def test_remove_row_keeps_width_when_other_row_is_still_widest():
+    """Removing a narrow row should not shrink the column when another
+    row still has the maximum content width."""
+    app = DataTableApp()
+    async with app.run_test() as pilot:
+        table: DataTable = app.query_one(DataTable)
+        (col,) = table.add_columns("col")
+        table.add_row("hi", key="narrow")
+        table.add_row("a much longer value", key="wide")
+        await pilot.pause()
+
+        assert table.columns[col].content_width == len("a much longer value")
+
+        table.remove_row("narrow")
+        await pilot.pause()
+
+        assert table.columns[col].content_width == len("a much longer value")
+
+
+async def test_remove_row_column_width_with_row_label():
+    """Removing the row that forced the label column's maximum width
+    should shrink the label column's content_width."""
+    app = DataTableApp()
+    async with app.run_test() as pilot:
+        table: DataTable = app.query_one(DataTable)
+        table.add_column("col")
+        table.add_row("v1", label="short", key="r1")
+        table.add_row("v2", label="a much longer label", key="r2")
+        await pilot.pause()
+
+        assert table._label_column.content_width == len("a much longer label")
+
+        table.remove_row("r2")
+        await pilot.pause()
+
+        assert table._label_column.content_width == len("short")
+
+

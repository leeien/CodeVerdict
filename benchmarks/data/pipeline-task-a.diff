diff --git a/tinydb/operations.py b/tinydb/operations.py
index 7101a23..8987422 100644
--- a/tinydb/operations.py
+++ b/tinydb/operations.py
@@ -71,3 +71,23 @@ def decrement(field: str) -> Callable[[MutableMapping], None]:
         doc[field] -= 1
 
     return transform
+
+
+def multiply(field: str, n: Union[int, float]) -> Callable[[MutableMapping], None]:
+    """
+    Multiply a given field in the document by ``n``.
+    """
+    def transform(doc: MutableMapping):
+        doc[field] *= n
+
+    return transform
+
+
+def divide(field: str, n: Union[int, float]) -> Callable[[MutableMapping], None]:
+    """
+    Divide a given field in the document by ``n``.
+    """
+    def transform(doc: MutableMapping):
+        doc[field] /= n
+
+    return transform

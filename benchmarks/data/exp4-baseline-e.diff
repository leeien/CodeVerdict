+async def test_max_length_programmatic_assignment():
+    """Check max_length is enforced when value is set programmatically."""
+
+    class InputApp(App):
+        def compose(self) -> ComposeResult:
+            yield Input(max_length=5)
+
+    async with InputApp().run_test() as pilot:
+        input_widget = pilot.app.query_one(Input)
+        input_widget.value = "abcdefgh"
+        assert input_widget.value == "abcde"
+
+
+async def test_max_length_constructor_value():
+    """Check max_length is enforced on the initial value passed to the constructor."""
+
+    class InputApp(App):
+        def compose(self) -> ComposeResult:
+            yield Input("toolongvalue", max_length=5)
+
+    async with InputApp().run_test() as pilot:
+        input_widget = pilot.app.query_one(Input)
+        assert input_widget.value == "toolongvalue"[:5]
+        assert len(input_widget.value) == 5
+
+
+async def test_max_length_constructor_value_exact():
+    """A constructor value exactly at max_length is accepted unchanged."""
+
+    class InputApp(App):
+        def compose(self) -> ComposeResult:
+            yield Input("hello", max_length=5)
+
+    async with InputApp().run_test() as pilot:
+        input_widget = pilot.app.query_one(Input)
+        assert input_widget.value == "hello"
+
+
+async def test_max_length_programmatic_assignment_exact():
+    """Programmatic assignment exactly at max_length is accepted unchanged."""
+
+    class InputApp(App):
+        def compose(self) -> ComposeResult:
+            yield Input(max_length=5)
+
+    async with InputApp().run_test() as pilot:
+        input_widget = pilot.app.query_one(Input)
+        input_widget.value = "hello"
+        assert input_widget.value == "hello"
+
+

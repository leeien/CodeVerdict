diff --git a/tests/test_console.py b/tests/test_console.py
index e52c1b36..b4960228 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -1133,3 +1133,41 @@ def test_tty_compatible() -> None:
     assert not console.is_terminal
     # Should not have auto-detected
     assert not console.file.called_isatty
+
+
+def test_link_coalescing_in_render_buffer():
+    """Consecutive segments with identical link values are wrapped in a single OSC 8 pair."""
+    console = Console(force_terminal=True, width=80)
+    with console.capture() as capture:
+        console.print("[link=https://example.org]Hello [bold]World[/bold][/link]")
+    result = capture.get()
+    # Should contain exactly one OSC 8 open (id=...;url) and one OSC 8 close
+    osc8_open_count = result.count("\x1b]8;id=")
+    osc8_close_count = result.count("\x1b]8;;\x1b\\")
+    assert osc8_open_count == 1, f"Expected 1 OSC 8 open, got {osc8_open_count}: {result!r}"
+    assert osc8_close_count == 1, f"Expected 1 OSC 8 close, got {osc8_close_count}: {result!r}"
+    assert "Hello " in result
+    assert "World" in result
+
+
+def test_multiple_links_not_coalesced():
+    """Distinct links on the same line remain separate OSC 8 pairs."""
+    console = Console(force_terminal=True, width=80)
+    with console.capture() as capture:
+        console.print(
+            "[link=https://example.org]First[/link] [link=https://other.org]Second[/link]"
+        )
+    result = capture.get()
+    assert result.count("\x1b]8;id=") == 2
+    assert result.count("\x1b]8;;\x1b\\") == 2
+
+
+def test_plain_link_unchanged():
+    """A plain link (no emphasis) still renders correctly with one OSC 8 pair."""
+    console = Console(force_terminal=True, width=80)
+    with console.capture() as capture:
+        console.print("[link=https://example.org]Click here[/link]")
+    result = capture.get()
+    assert result.count("\x1b]8;id=") == 1
+    assert result.count("\x1b]8;;\x1b\\") == 1
+    assert "Click here" in result

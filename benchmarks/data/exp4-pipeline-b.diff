+async def test_remove_row_column_width_shrinks():
+    """When the row containing a column's widest cell is removed, that column shrinks."""
+    app = DataTableApp()
+    async with app.run_test() as pilot:
+        table = app.query_one(DataTable)
+        col_key = table.add_column("Col")
+        table.add_row("short", key="short_row")
+        table.add_row("a much longer value", key="wide_row")
+        await pilot.pause()
+        wide_width = table.columns[col_key].content_width
+        table.remove_row("wide_row")
+        await pilot.pause()
+        narrow_width = table.columns[col_key].content_width
+        assert narrow_width < wide_width
+
+
+async def test_remove_row_column_width_stable():
+    """When a removed row has no column's widest cell, all column widths stay the same."""
+    app = DataTableApp()
+    async with app.run_test() as pilot:
+        table = app.query_one(DataTable)
+        col_key = table.add_column("Col")
+        table.add_row("a much longer value", key="wide_row")
+        table.add_row("short", key="short_row")
+        await pilot.pause()
+        width_before = table.columns[col_key].content_width
+        table.remove_row("short_row")
+        await pilot.pause()
+        width_after = table.columns[col_key].content_width
+        assert width_after == width_before
+
+

 import subprocess
 import sys
 import tempfile
@@ -1133,3 +1134,65 @@ def test_tty_compatible() -> None:
     assert not console.is_terminal
     # Should not have auto-detected
     assert not console.file.called_isatty
+
+
+def test_link_id_stable_across_emphasis_splits() -> None:
+    """All OSC 8 segments for the same URL must share one link id.
+
+    When an emphasised word falls inside a hyperlink the text is split into
+    several Segments (before, emphasised word, after).  Each Segment must still
+    carry the *same* OSC 8 id so that the terminal treats the whole URL as one
+    continuous clickable region.
+    """
+    console = Console(
+        file=io.StringIO(), force_terminal=True, legacy_windows=False, _environ={}
+    )
+    url = "https://www.example.com/path"
+    text = Text(url)
+    # Apply the link to the entire URL
+    text.stylize(f"link {url}", 0, len(url))
+    # "example" sits at index 12–19 inside the URL; highlight it in bold red
+    text.stylize("bold red", 12, 19)
+    console.print(text, end="")
+    output = console.file.getvalue()
+
+    # Collect (id, url) pairs from every OSC 8 open-link sequence
+    link_opens = re.findall(
+        r"\x1b\]8;id=([^;]+);([^\x1b]+)\x1b\\",
+        output,
+    )
+    url_opens = [(lid, u) for lid, u in link_opens if u == url]
+
+    # The emphasis should have produced multiple link segments …
+    assert len(url_opens) > 1, (
+        "Expected the link to be split into multiple OSC 8 segments by the emphasis"
+    )
+    # … but every segment must carry the identical id.
+    ids = {lid for lid, _ in url_opens}
+    assert len(ids) == 1, (
+        f"Link id changed between segments for {url!r}: found ids {ids!r}"
+    )
+
+
+def test_link_id_stable_multiple_occurrences_same_url() -> None:
+    """The same URL printed twice reuses the same stable link id throughout."""
+    console = Console(
+        file=io.StringIO(), force_terminal=True, legacy_windows=False, _environ={}
+    )
+    url = "https://docs.example.org"
+    text = Text(f"See {url} and also {url}")
+    # Two separate link spans that share the same URL
+    text.stylize(f"link {url}", 4, 4 + len(url))
+    text.stylize(f"link {url}", 4 + len(url) + 9, 4 + len(url) + 9 + len(url))
+    # Emphasise the word "docs" (index 8 in the first occurrence)
+    text.stylize("bold", 8, 12)
+    console.print(text, end="")
+    output = console.file.getvalue()
+
+    link_opens = re.findall(r"\x1b\]8;id=([^;]+);([^\x1b]+)\x1b\\", output)
+    url_opens = [lid for lid, u in link_opens if u == url]
+
+    assert len(url_opens) > 1, "Expected multiple link segments"
+    assert len(set(url_opens)) == 1, (
+        f"Expected all link segments for {url!r} to share one id, got {set(url_opens)!r}"
+    )
diff --git a/tests/test_style.py b/tests/test_style.py
index 84a65a67..d0e20426 100644
--- a/tests/test_style.py
+++ b/tests/test_style.py
@@ -162,6 +162,23 @@ def test_render():
     assert Style().render("foo") == "foo"
 
 
+def test_render_link_id_override():
+    """render() should use the supplied link_id instead of the style's own id."""
+    style = Style(link="https://example.org")
+    default_rendered = style.render("click")
+    # The style's own id is used when no override is supplied
+    assert f"id={style.link_id};" in default_rendered
+
+    # An explicit link_id overrides the style's own id
+    overridden = style.render("click", link_id="custom-id-42")
+    assert "id=custom-id-42;" in overridden
+    assert f"id={style.link_id};" not in overridden
+
+    # The URL and text are still present
+    assert "https://example.org" in overridden
+    assert "click" in overridden
+
+
 def test_test():
     Style(color="red").test("hello")
 

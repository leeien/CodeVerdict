+def multiply(field: str, n: Union[int, float]) -> Callable[[MutableMapping], None]:
+    """
+    Multiply a given field in the document by ``n``.
+    """
+    def transform(doc: MutableMapping):
+        doc[field] *= n
+
+    return transform
+

+def test_progressbar_speed_hidden(runner):
+    with _create_progress(5, show_speed=False) as progress:
+        progress.pos = 3
+        assert "it/s" not in progress.format_progress_line()
+
+
+def test_progressbar_speed_shown(runner, monkeypatch):
+    fake_clock = FakeClock()
+    monkeypatch.setattr(time, "time", fake_clock.time)
+
+    with _create_progress(5, show_speed=True) as progress:
+        progress.pos = 3
+        fake_clock.advance_time(3)
+        line = progress.format_progress_line()
+        assert re.search(r"\d+\.\d{2} it/s", line)
+
+
+def test_progressbar_speed_before_first_item(runner):
+    with _create_progress(5, show_speed=True) as progress:
+        assert "? it/s" in progress.format_progress_line()
+
+
+def test_progressbar_speed_end_to_end(runner, monkeypatch):
+    fake_clock = FakeClock()
+
+    @click.command()
+    def cli():
+        with click.progressbar(range(3), show_speed=True) as progress:
+            for _ in progress:
+                fake_clock.advance_time()
+
+    monkeypatch.setattr(time, "time", fake_clock.time)
+    monkeypatch.setattr(click._termui_impl, "isatty", lambda _: True)
+    output = runner.invoke(cli, []).output
+    assert re.search(r"\d+\.\d{2} it/s", output)
+
+

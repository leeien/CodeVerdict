+def test_decode_windows_line_endings():
+    """Windows programs produce CRLF (\\r\\n) output. The trailing \\r must not be
+    treated as a cursor-overwrite that erases the line content.
+    Regression test for Windows captured output showing blank lines.
+    """
+    decoder = AnsiDecoder()
+
+    # Plain text with Windows CRLF endings
+    lines = list(decoder.decode("line1\r\nline2\r\nline3\r\n"))
+    assert [str(t) for t in lines] == ["line1", "line2", "line3", ""]
+
+    # ANSI-styled text with Windows CRLF endings
+    lines = list(decoder.decode("\x1b[1mfoo\x1b[0m\r\nbar\r\nbaz\r\n"))
+    assert [str(t) for t in lines] == ["foo", "bar", "baz", ""]
+
+    # In-line CR (cursor overwrite / progress animation) still works with CRLF
+    lines = list(decoder.decode("10%\r20%\r\nline2\r\n"))
+    assert [str(t) for t in lines] == ["20%", "line2", ""]
+
